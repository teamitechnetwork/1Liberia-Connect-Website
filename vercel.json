{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "BASE_PATH=/ PORT=4173 pnpm --filter @workspace/one-liberia-connect run build",
  "outputDirectory": "artifacts/one-liberia-connect/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
